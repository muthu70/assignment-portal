# ===== Fill in the lines below, then save as .env (no .example) =====
# 1. MONGO_URI: paste your MongoDB Atlas connection string on one line.
#    Example: mongodb+srv://myuser:mypassword@cluster0.xxxxx.mongodb.net/assignment_portal?appName=Cluster0
MONGO_URI=PASTE_YOUR_MONGODB_CONNECTION_STRING_HERE

# 2. JWT_SECRET: any long random sentence (30+ characters)
JWT_SECRET=change-this-to-a-long-random-sentence-2026

PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# 3. Admin login you will use on the website
ADMIN_NAME=College Admin
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=ChooseAPassword123
